{
  "name": "dribbble-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev",
    "db:types": "node scripts/db-types.mjs",
    "check:env": "node --env-file=.env.local scripts/check-env.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:unsplash": "node --env-file=.env.local scripts/seed.mjs --unsplash",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:report": "node node_modules/@playwright/test/cli.js show-report"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
