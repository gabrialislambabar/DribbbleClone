# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.pnpm-store
/.npm
/.cache

# ---------------------------------------------------------------------------
# Build output and caches
# ---------------------------------------------------------------------------
/.next/
/out/
/build
/dist
/coverage
*.tsbuildinfo
next-env.d.ts
.turbo/
/.turbo/
.eslintcache
.prettiercache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pid
*.seed

# ---------------------------------------------------------------------------
# Test artifacts
# ---------------------------------------------------------------------------
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
coverage-final.json
junit*.xml
*.lcov

# ---------------------------------------------------------------------------
# Environment and secret files
# The example template is intentionally tracked; real values never are.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.local.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
secrets/
.secrets/
credentials.json
*credentials*.json
*service-account*.json
firebase-adminsdk*.json
gcloud-*.json
*secret*.json
*.env.json
*.secret
*.secrets
id_rsa
id_ed25519
*.ppk
.ssh/
.aws/
.gcloud/
.npmrc
.pypirc
.netrc
.htpasswd
supabase/.temp/
supabase/.branches/
supabase/.env

# ---------------------------------------------------------------------------
# Local / generated JSON
# App config stays tracked: package.json, package-lock.json, tsconfig.json,
# supabase/config.json, and any other committed configuration.
# ---------------------------------------------------------------------------
*.local.json
*.generated.json
*.tmp.json
.vercel/
.vscode/
.idea/

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
