# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Legacy anon key or the newer sb_publishable_... key. Safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Service role key. Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public site origin used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by `npm run db:types`.
SUPABASE_PROJECT_ID=<project-ref>

# Unsplash Access Key. Server-only. Create an app at
# https://unsplash.com/oauth/applications and copy the Access Key.
# Do not use the Secret Key and never expose this with a NEXT_PUBLIC_ prefix.
UNSPLASH_ACCESS_KEY=

# Optional: Sentry error reporting. Leave blank to disable reporting.
# SENTRY_DSN is used by the server and edge runtimes; the NEXT_PUBLIC_ variant
# is used by the browser. The org/project/auth token are only needed for
# source-map uploads during production builds.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: Playwright base URL (defaults to http://localhost:3000).
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Optional: admin account used by the moderation e2e spec. Promote the account
# first with: update public.profiles set is_admin = true where username = '<name>';
PLAYWRIGHT_ADMIN_EMAIL=
PLAYWRIGHT_ADMIN_PASSWORD=

# Optional: set to 1 to run the realtime e2e specs (Realtime must be enabled).
PLAYWRIGHT_REALTIME=
